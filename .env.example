# Server
PORT=4000
NODE_ENV=production
JWT_SECRET=change-me-in-production

# Database (DigitalOcean Managed PostgreSQL)
DATABASE_URL=postgres://user:password@host:25060/teneo?sslmode=require

# Frontend (leave empty for same-origin in production)
VITE_API_URL=
VITE_WS_URL=

# Teneo Community API
TENEO_COMMUNITY_API_URL=https://api.teneo.pro
TENEO_COMMUNITY_API_KEY=change-me
