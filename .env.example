# Server
PORT=4000
NODE_ENV=production
JWT_SECRET=change-me-in-production

# Database (DigitalOcean Managed PostgreSQL)
DATABASE_URL=postgres://user:password@host:25060/teneo?sslmode=require

# Frontend (leave empty for same-origin in production)
VITE_API_URL=
VITE_WS_URL=

# Dev only — remove in production
# VITE_DEV_AUTH_BYPASS=true
# VITE_DEV_TEST_WALLET=0x...
# DEV_AUTH_BYPASS=true
