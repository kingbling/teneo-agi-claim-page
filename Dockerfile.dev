FROM node:20-alpine

# Install tmux and build tools
RUN apk add --no-cache tmux python3 make g++ bash

WORKDIR /app

# Copy package files for both frontend and server
COPY package*.json ./
COPY server/package*.json ./server/

# Install dependencies
RUN npm ci
RUN cd server && npm ci

# Copy source (will be overridden by volume mount in dev)
COPY . .

# Create startup script with split panes and logging
RUN echo '#!/bin/bash' > /start.sh && \
    echo 'cd /app' >> /start.sh && \
    echo '' >> /start.sh && \
    echo '# Create logs directory and clear old logs' >> /start.sh && \
    echo 'mkdir -p /app/logs' >> /start.sh && \
    echo 'rm -f /app/logs/server.log /app/logs/frontend.log' >> /start.sh && \
    echo 'echo "=== Server started at $(date) ===" > /app/logs/server.log' >> /start.sh && \
    echo 'echo "=== Frontend started at $(date) ===" > /app/logs/frontend.log' >> /start.sh && \
    echo '' >> /start.sh && \
    echo '# Start tmux session' >> /start.sh && \
    echo 'tmux new-session -d -s teneo -n dev' >> /start.sh && \
    echo '' >> /start.sh && \
    echo '# Split horizontally (top/bottom)' >> /start.sh && \
    echo 'tmux split-window -v -t teneo:dev' >> /start.sh && \
    echo '' >> /start.sh && \
    echo '# Top pane: Server (pane 0) - with tee to log' >> /start.sh && \
    echo 'tmux select-pane -t teneo:dev.0' >> /start.sh && \
    echo 'tmux send-keys -t teneo:dev.0 "cd /app/server && echo \"=== SERVER (port 4444) ===\" && PORT=4444 npm run dev 2>&1 | tee -a /app/logs/server.log" C-m' >> /start.sh && \
    echo '' >> /start.sh && \
    echo '# Bottom pane: Frontend (pane 1) - with tee to log' >> /start.sh && \
    echo 'tmux send-keys -t teneo:dev.1 "cd /app && echo \"=== FRONTEND (port 5175) ===\" && npm run dev -- --host 0.0.0.0 2>&1 | tee -a /app/logs/frontend.log" C-m' >> /start.sh && \
    echo '' >> /start.sh && \
    echo '# Select top pane by default' >> /start.sh && \
    echo 'tmux select-pane -t teneo:dev.0' >> /start.sh && \
    echo '' >> /start.sh && \
    echo '# Keep container running' >> /start.sh && \
    echo 'tail -f /dev/null' >> /start.sh && \
    chmod +x /start.sh

# Expose ports
EXPOSE 4444 5175

CMD ["/start.sh"]
